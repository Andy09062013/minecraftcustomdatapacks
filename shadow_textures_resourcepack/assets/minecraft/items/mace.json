{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "explosive_mace",
        "model": {
          "type": "minecraft:model",
          "model": "shadow:item/explosive_mace"
        }
      },
      {
        "when": "super_mace",
        "model": {
          "type": "minecraft:model",
          "model": "shadow:item/super_mace"
        }
      },
      {
        "when": "mallet",
        "model": {
          "type": "minecraft:model",
          "model": "shadow:item/mallet"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/mace"
    }
  }
}