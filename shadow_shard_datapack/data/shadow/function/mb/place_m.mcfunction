$summon minecraft:marker ~ ~ ~ {Tags:["mb.part","mb.new","mb.base"],Rotation:[$(yaw)f,0f]}
$summon minecraft:block_display ~ ~ ~ {Tags:["mb.part","mb.new"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:dark_oak_fence"},interpolation_duration:5,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.5f,0f,-0.5f],scale:[1f,1f,1f]}}
$summon minecraft:block_display ~ ~ ~ {Tags:["mb.part","mb.new"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:iron_block"},interpolation_duration:5,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.21f,1.0f,-0.35f],scale:[0.42f,0.36f,0.7f]}}
$summon minecraft:block_display ~ ~ ~ {Tags:["mb.part","mb.new"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:light_gray_concrete"},interpolation_duration:5,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.19f,1.36f,-0.33f],scale:[0.38f,0.06f,0.66f]}}
$summon minecraft:block_display ~ ~ ~ {Tags:["mb.part","mb.new"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:gray_concrete"},interpolation_duration:5,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.18f,1.03f,0.35f],scale:[0.36f,0.3f,0.02f]}}
$summon minecraft:block_display ~ ~ ~ {Tags:["mb.part","mb.new","mb.flag","mb.pole"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:red_concrete"},interpolation_duration:5,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0.21f,1.15f,-0.32f],scale:[0.04f,0.04f,0.4f]}}
$summon minecraft:block_display ~ ~ ~ {Tags:["mb.part","mb.new","mb.flag","mb.plate"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:red_concrete"},interpolation_duration:5,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0.21f,1.04f,0.06f],scale:[0.04f,0.15f,0.2f]}}
$summon minecraft:text_display ~ ~1.75 ~ {Tags:["mb.part","mb.new"],billboard:"center",background:0,shadow:1b,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.6f,0.6f,0.6f]},text:{text:"📫 $(name)'s Mailbox",color:"gold"}}
summon minecraft:interaction ~ ~ ~ {Tags:["mb.part","mb.new","mb.int"],width:0.9f,height:1.5f,response:1b}
$execute unless data storage shadow:mbox box[{id:$(id)}] run data modify storage shadow:mbox box append value {id:$(id),items:[]}
$data modify storage shadow:mbox box[{id:$(id)}].v set value $(v)
